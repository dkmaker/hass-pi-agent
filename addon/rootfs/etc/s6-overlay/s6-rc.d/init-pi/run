#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Pi Agent Add-on: Environment setup
# Sets up PI_CODING_AGENT_DIR and environment variables
# ==============================================================================

bashio::log.info 'Setting up Pi Agent environment...'

# --- Persistent storage ---
PI_DIR=/data/pi-agent
mkdir -p "${PI_DIR}/sessions"

# --- Docs cache ---
mkdir -p /data/ha-docs

# --- Agent scratch/data dir (agent cwd; freely writable, config stays gated) ---
mkdir -p /homeassistant/agent

# --- Write s6 env vars (available to all services via with-contenv) ---
printf '%s' "${PI_DIR}" > /var/run/s6/container_environment/PI_CODING_AGENT_DIR
printf '%s' "${SUPERVISOR_TOKEN}" > /var/run/s6/container_environment/HA_TOKEN
printf '%s' "http://supervisor/core" > /var/run/s6/container_environment/HA_URL
printf '%s' "/homeassistant" > /var/run/s6/container_environment/HA_CONFIG_PATH
printf '%s' "/data/ha-docs" > /var/run/s6/container_environment/HA_DOCS_DATA_DIR
printf '%s' "1" > /var/run/s6/container_environment/PI_SKIP_VERSION_CHECK

# --- Write profile.d for interactive shells (tmux/ttyd) ---
{
    echo "export PI_CODING_AGENT_DIR=\"${PI_DIR}\""
    echo "export SUPERVISOR_TOKEN=\"${SUPERVISOR_TOKEN}\""
    echo "export HA_TOKEN=\"${SUPERVISOR_TOKEN}\""
    echo "export HA_URL=\"http://supervisor/core\""
    echo "export HA_CONFIG_PATH=\"/homeassistant\""
    echo "export HA_DOCS_DATA_DIR=\"/data/ha-docs\""
    echo "export PI_SKIP_VERSION_CHECK=\"1\""
} > /etc/profile.d/pi-agent.sh

# --- AI provider / model / API key ---
# Configured in-app (welcome screen / settings inside the Pi Agent panel) and
# persisted by the engine to /data/engine-agentdir (selection.json + auth.json).
# No provider/model/key env mapping here — the engine owns that setup now.

# --- Write-guard (filesystem write allowlist) ---
write_guard_mode=$(bashio::config 'write_guard')
if bashio::var.has_value "${write_guard_mode}"; then
    printf '%s' "${write_guard_mode}" > /var/run/s6/container_environment/PI_WRITE_GUARD_MODE
    echo "export PI_WRITE_GUARD_MODE=\"${write_guard_mode}\"" >> /etc/profile.d/pi-agent.sh
fi

# write_guard_allow is a list of extra writable globs (relative to /homeassistant).
# Join into a comma-delimited string for the env var the extension reads.
write_guard_allow=""
for entry in $(bashio::config 'write_guard_allow'); do
    if [[ -n "${write_guard_allow}" ]]; then
        write_guard_allow="${write_guard_allow},${entry}"
    else
        write_guard_allow="${entry}"
    fi
done
if [[ -n "${write_guard_allow}" ]]; then
    printf '%s' "${write_guard_allow}" > /var/run/s6/container_environment/PI_WRITE_GUARD_ALLOW
    echo "export PI_WRITE_GUARD_ALLOW=\"${write_guard_allow}\"" >> /etc/profile.d/pi-agent.sh
    bashio::log.info "Write-guard extra allowlist: ${write_guard_allow}"
fi

# --- Persistent bash history ---
touch /data/.bash_history
ln -sf /data/.bash_history /root/.bash_history

# --- Pi settings: quiet startup, collapse changelog ---
PI_SETTINGS="${PI_DIR}/settings.json"
if [[ ! -f "${PI_SETTINGS}" ]]; then
    echo '{}' > "${PI_SETTINGS}"
fi
tmp=$(mktemp)
jq '. + {"quietStartup": true, "collapseChangelog": true}' "${PI_SETTINGS}" > "$tmp" && mv "$tmp" "${PI_SETTINGS}"

# --- Pre-trust the agent dirs (pi runs with cwd=/homeassistant/agent; also
#     trust /homeassistant so config edits never prompt) ---
PI_TRUST="${PI_DIR}/trust.json"
if [[ ! -f "${PI_TRUST}" ]]; then
    echo '{}' > "${PI_TRUST}"
fi
tmp=$(mktemp)
jq '. + {"/homeassistant": true, "/homeassistant/agent": true}' "${PI_TRUST}" > "$tmp" && mv "$tmp" "${PI_TRUST}"

# --- Clean up legacy extension copy from /homeassistant volume ---
if [[ -d /homeassistant/.pi/extensions/home-assistant ]]; then
    bashio::log.info 'Removing legacy extension from /homeassistant/.pi/extensions/home-assistant...'
    rm -rf /homeassistant/.pi/extensions/home-assistant
fi

# --- Convenient symlinks ---
ln -sf /homeassistant /root/homeassistant
ln -sf /share /root/share

bashio::log.info 'Pi Agent environment ready.'
